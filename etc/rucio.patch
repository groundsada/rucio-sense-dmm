+    def _load_sense_activities(self) -> set[str]:
+        """Load and normalize SENSE-eligible activities from configuration."""
+        activities_str = config_get('dmm', 'activities', False, 'sense test')
+        return {activity.strip().lower() for activity in activities_str.split(',')}
+
+    def _query_dmm(self, rule_id: str) -> Optional[dict[str, str]]:
+        """
+        Query DMM for SENSE network endpoints.
+        
+        :param rule_id: Rucio rule ID
+        :returns: Dict with 'source' and 'destination' keys, or None on failure
+        """
+        if rule_id in self.dmm_cache:
+            return self.dmm_cache[rule_id]
+        
+        try:
+            response = requests.get(f'{self.dmm_url}/query/{rule_id}', timeout=5)
+            response.raise_for_status()
+            data = response.json()
+            
+            if not isinstance(data, dict) or 'source' not in data or 'destination' not in data:
+                self.logger(logging.WARNING, f"Invalid DMM response for {rule_id}")
+                return None
+            
+            self.dmm_cache[rule_id] = data
+            self.logger(logging.DEBUG, f"DMM endpoints for {rule_id}: {data['source']} -> {data['destination']}")
+            return data
+            
+        except requests.RequestException as e:
+            self.logger(logging.ERROR, f"DMM query failed for {rule_id}: {e}")
+            return None
+
+    def _replace_hostname(self, url: str, new_hostname: str) -> str:
+        """
+        Replace hostname in URL using proper URL parsing.
+        """
+        parsed = urlparse(url)
+        return urlunparse(parsed._replace(netloc=new_hostname))
+
+    def _apply_sense_routing(self, files: list[dict]) -> None:
+        """
+        Apply SENSE network routing to eligible transfers.
+        """
+        if not self.dmm_url:
+            return
+        
+        for file in files:
+            if file.get('activity', '').lower() not in self.sense_activities:
+                continue
+            
+            rule_id = file.get('metadata', {}).get('rule_id')
+            if not rule_id:
+                continue
+            
+            endpoints = self._query_dmm(rule_id)
+            if not endpoints:
+                continue
+            
+            # Apply SENSE endpoints
+            if file.get('sources'):
+                old_src = file['sources'][0]
+                file['sources'][0] = self._replace_hostname(old_src, endpoints['source'])
+                self.logger(logging.INFO, f"SENSE routing {rule_id}: source {old_src} -> {file['sources'][0]}")
+            
+            if file.get('destinations'):
+                old_dst = file['destinations'][0]
+                file['destinations'][0] = self._replace_hostname(old_dst, endpoints['destination'])
+                self.logger(logging.INFO, f"SENSE routing {rule_id}: dest {old_dst} -> {file['destinations'][0]}")
+
