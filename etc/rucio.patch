+                continue
+
+            endpoints, reason = self._query_dmm(rule_id)
+            if reason is not None:
+                self.SENSE_ROUTING_SKIPPED.labels(reason=reason).inc()
+                continue
+
+            # Apply SENSE endpoints
+            applied = False
+            if file.get('sources'):
+                old_src = file['sources'][0]
+                file['sources'][0] = self._replace_hostname(old_src, endpoints['source'])
+                self.logger(logging.INFO, f"SENSE routing {rule_id}: source {old_src} -> {file['sources'][0]}")
+                applied = True
+
+            if file.get('destinations'):
+                old_dst = file['destinations'][0]
+                file['destinations'][0] = self._replace_hostname(old_dst, endpoints['destination'])
+                self.logger(logging.INFO, f"SENSE routing {rule_id}: dest {old_dst} -> {file['destinations'][0]}")
+                applied = True
+
+            # DMM answered but the transfer had nothing to rewrite. Counted
+            # apart from a DMM failure because it is a different bug.
+            if applied:
+                self.SENSE_ROUTING_APPLIED.inc()
+            else:
+                self.SENSE_ROUTING_SKIPPED.labels(reason='no_endpoints_in_transfer').inc()
