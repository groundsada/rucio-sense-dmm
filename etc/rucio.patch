+    def _apply_sense_routing(self, files: list[dict]) -> None:
+        """
+        Apply SENSE network routing to eligible transfers.
+        """
+        if not self.dmm_url:
+            return
+        
+        for file in files:
+            if file.get('activity', '').lower() not in self.sense_activities:
+                continue
+            
+            rule_id = file.get('metadata', {}).get('rule_id')
+            if not rule_id:
