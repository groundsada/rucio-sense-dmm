+    def _query_dmm(self, rule_id: str) -> tuple[Optional[dict[str, str]], Optional[str]]:
+        """
+        Query DMM for SENSE network endpoints, through a bounded expiring cache.
+
+        A failed refresh is never papered over with the previous answer. Not
+        routing is the safe failure — the transfer still completes over the
+        default path — whereas rewriting to an endpoint DMM may have already
+        reallocated can fail it outright. It is also what already happens for a
+        rule that was never cached, so DMM being unreachable has one behaviour
+        rather than two.
+
+        :param rule_id: Rucio rule ID
+        :returns: (endpoints, skip_reason), exactly one of which is set
+        """
+        now = monotonic()
+        cached = self.dmm_cache.get(rule_id)
+        if cached is not None and now < cached[0]:
+            self.dmm_cache.move_to_end(rule_id)
+            return cached[1], cached[2]
+
+        data, reason = self._fetch_dmm(rule_id)
+        ttl = self.DMM_CACHE_TTL if reason is None else self.DMM_CACHE_NEGATIVE_TTL
+        self.dmm_cache[rule_id] = (now + ttl, data, reason)
+        self.dmm_cache.move_to_end(rule_id)
+        while len(self.dmm_cache) > self.DMM_CACHE_MAX_ENTRIES:
+            self.dmm_cache.popitem(last=False)
+        return data, reason
+
+    def _fetch_dmm(self, rule_id: str) -> tuple[Optional[dict[str, str]], Optional[str]]:
+        """One uncached call to DMM. Returns (endpoints, skip_reason)."""
+        with ExitStack() as stack:
+            headers: dict[str, str] = {}
+            if otel_trace is not None:
+                # A traceparent is only emitted while a span is current, so the
+                # call is wrapped even though the transfertool keeps no span of
+                # its own. Without this DMM's /query starts a fresh trace with
+                # no parent and the two halves of the only cross-component story
+                # in this system — Rucio deciding a rule is SENSE-eligible, DMM
+                # allocating, SENSE-O programming the network — never join.
+                # With no tracing configured this is a non-recording span and
+                # inject writes nothing, so the request is unchanged.
+                span = stack.enter_context(
+                    otel_trace.get_tracer(__name__).start_as_current_span('rucio.query_dmm'))
+                span.set_attribute('dmm.rule_id', rule_id)
+                otel_inject(headers)
+
+            try:
+                response = requests.get(f'{self.dmm_url}/query/{rule_id}', headers=headers, timeout=5)
+                response.raise_for_status()
+                data = response.json()
+
+                if not isinstance(data, dict) or 'source' not in data or 'destination' not in data:
+                    self.logger(logging.WARNING, f"Invalid DMM response for {rule_id}")
+                    return None, 'invalid_response'
+
+                self.logger(logging.DEBUG, f"DMM endpoints for {rule_id}: {data['source']} -> {data['destination']}")
+                return data, None
+
+            except requests.RequestException as e:
+                # A 404 is DMM saying the rule is not allocated yet, which is
+                # normal in the window between rule creation and the allocator
+                # reaching it. Anything else means DMM could not be reached,
+                # which is the one an operator has to see.
+                response = getattr(e, 'response', None)
+                if response is not None and response.status_code == 404:
+                    self.logger(logging.DEBUG, f"DMM has not allocated {rule_id} yet")
+                    return None, 'not_allocated'
+                self.logger(logging.ERROR, f"DMM query failed for {rule_id}: {e}")
+                return None, 'dmm_unreachable'
+
